# Keep source files consistent across Windows, macOS and Linux.
* text=auto

*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.tf text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Deployment packages and diagrams are binary assets.
*.zip binary
*.jpg binary
*.jpeg binary
*.png binary
